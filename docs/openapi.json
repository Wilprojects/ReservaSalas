{
  "openapi": "3.0.4",
  "info": {
    "title": "API de Gestión de Reservas de Salas",
    "description": "API REST desarrollada en ASP.NET Core para administrar reservas de salas de reuniones de una organización.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5093/"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "ReservaSalas.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/reservas": {
      "get": {
        "tags": [
          "Reservas"
        ],
        "summary": "Obtiene las reservas registradas.",
        "description": "Si se proporciona el parámetro fecha, devuelve únicamente\r\nlas reservas correspondientes a dicha fecha.\r\nSi no se proporciona, devuelve todas las reservas.",
        "operationId": "GetReservas",
        "parameters": [
          {
            "name": "fecha",
            "in": "query",
            "description": "Fecha opcional utilizada para filtrar las reservas.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-10-15"
          }
        ],
        "responses": {
          "200": {
            "description": "Reservas obtenidas correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservaResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "El formato del parámetro fecha no es válido."
          },
          "401": {
            "description": "No se proporcionó un token JWT válido."
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "Reservas"
        ],
        "summary": "Registra una nueva reserva de sala.",
        "description": "Toda nueva reserva se registra inicialmente con estado Pendiente.\r\nEl identificador es generado automáticamente por la API.",
        "operationId": "CreateReserva",
        "requestBody": {
          "description": "Datos necesarios para registrar la reserva.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearReservaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Reserva creada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Los datos enviados no cumplen las reglas de validación.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token JWT válido."
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/reservas/{id}": {
      "get": {
        "tags": [
          "Reservas"
        ],
        "summary": "Obtiene una reserva por su identificador.",
        "operationId": "GetReservaById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único de la reserva.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Reserva encontrada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe una reserva con el identificador indicado."
          },
          "401": {
            "description": "No se proporcionó un token JWT válido."
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "put": {
        "tags": [
          "Reservas"
        ],
        "summary": "Actualiza una reserva existente.",
        "operationId": "UpdateReserva",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador de la reserva que será actualizada.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "description": "Nuevos datos de la reserva.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarReservaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Reserva actualizada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe una reserva con el identificador indicado."
          },
          "400": {
            "description": "Los datos enviados no cumplen las reglas de validación.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token JWT válido."
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "delete": {
        "tags": [
          "Reservas"
        ],
        "summary": "Elimina una reserva existente.",
        "operationId": "DeleteReserva",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador de la reserva que será eliminada.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          }
        ],
        "responses": {
          "204": {
            "description": "Reserva eliminada correctamente."
          },
          "404": {
            "description": "No existe una reserva con el identificador indicado."
          },
          "401": {
            "description": "No se proporcionó un token JWT válido."
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActualizarReservaRequest": {
        "required": [
          "nombreSala",
          "fechaReserva",
          "horaInicio",
          "horaFin",
          "nombreResponsable",
          "cantidadAsistentes",
          "motivo",
          "estado"
        ],
        "type": "object",
        "properties": {
          "nombreSala": {
            "maxLength": 100,
            "type": "string",
            "description": "Nombre de la sala reservada."
          },
          "fechaReserva": {
            "type": "string",
            "description": "Fecha de la reserva.",
            "format": "date"
          },
          "horaInicio": {
            "type": "string",
            "description": "Hora de inicio de la reunión.",
            "format": "time"
          },
          "horaFin": {
            "type": "string",
            "description": "Hora de finalización.\r\nDebe ser posterior a la hora de inicio.",
            "format": "time"
          },
          "nombreResponsable": {
            "maxLength": 100,
            "type": "string",
            "description": "Nombre de la persona responsable de la reserva."
          },
          "cantidadAsistentes": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Cantidad de asistentes. Debe ser mayor a cero.",
            "format": "int32"
          },
          "motivo": {
            "maxLength": 500,
            "type": "string",
            "description": "Motivo de la reunión."
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoReserva"
          }
        },
        "description": "Datos utilizados para actualizar una reserva existente."
      },
      "CrearReservaRequest": {
        "required": [
          "nombreSala",
          "fechaReserva",
          "horaInicio",
          "horaFin",
          "nombreResponsable",
          "cantidadAsistentes",
          "motivo"
        ],
        "type": "object",
        "properties": {
          "nombreSala": {
            "maxLength": 100,
            "type": "string",
            "description": "Nombre de la sala que será reservada."
          },
          "fechaReserva": {
            "type": "string",
            "description": "Fecha en la que se realizará la reserva.",
            "format": "date"
          },
          "horaInicio": {
            "type": "string",
            "description": "Hora de inicio de la reunión.",
            "format": "time"
          },
          "horaFin": {
            "type": "string",
            "description": "Hora de finalización de la reunión.\r\nDebe ser posterior a la hora de inicio.",
            "format": "time"
          },
          "nombreResponsable": {
            "maxLength": 100,
            "type": "string",
            "description": "Nombre de la persona responsable de la reserva."
          },
          "cantidadAsistentes": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Cantidad de personas que asistirán a la reunión.\r\nDebe ser mayor a cero.",
            "format": "int32"
          },
          "motivo": {
            "maxLength": 500,
            "type": "string",
            "description": "Motivo o descripción de la reunión."
          }
        },
        "description": "Datos necesarios para registrar una nueva reserva de sala."
      },
      "EstadoReserva": {
        "enum": [
          "Pendiente",
          "Confirmada",
          "Cancelada"
        ],
        "description": "Estados posibles de una reserva de sala."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ReservaResponse": {
        "required": [
          "id",
          "nombreSala",
          "fechaReserva",
          "horaInicio",
          "horaFin",
          "nombreResponsable",
          "cantidadAsistentes",
          "motivo",
          "estado"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Identificador único de la reserva.",
            "format": "int32"
          },
          "nombreSala": {
            "type": "string",
            "description": "Nombre de la sala reservada."
          },
          "fechaReserva": {
            "type": "string",
            "description": "Fecha de la reserva.",
            "format": "date"
          },
          "horaInicio": {
            "type": "string",
            "description": "Hora de inicio de la reserva.",
            "format": "time"
          },
          "horaFin": {
            "type": "string",
            "description": "Hora de finalización de la reserva.",
            "format": "time"
          },
          "nombreResponsable": {
            "type": "string",
            "description": "Persona responsable de la reserva."
          },
          "cantidadAsistentes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Número de asistentes.",
            "format": "int32"
          },
          "motivo": {
            "type": "string",
            "description": "Motivo de la reunión."
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoReserva"
          }
        },
        "description": "Representa la información de una reserva devuelta por la API."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Ingrese el token JWT para autenticar las solicitudes.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "ReservaSalas.Api"
    },
    {
      "name": "Reservas"
    }
  ]
}